results/live/**/workspace/
results/live/**/home/
results/live/**/import-*/
# built archives (deposited on Zenodo, not committed)
dist/

# LaTeX build output
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.log
paper/**/*.out
paper/**/*.toc
paper/**/*.synctex.gz
paper/**/*.fdb_latexmk
paper/**/*.fls
paper/main.pdf
