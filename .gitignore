.DS_Store
.env
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
# local clones of the system under study, built binaries, toolchain caches
.cache/
# raw live logs are archived separately with checksums (REPRODUCING.md)
results/**/raw/
